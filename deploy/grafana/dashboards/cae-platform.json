  "panels": [
    {
      "id": 1,
      "title": "Backend scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cae-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cae-backend\"}",
          "legendFormat": "{{status}} {{analysis_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
