{
  "uid": "cae-platform",
  "title": "CAE Platform — Public Mock Demo",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "cae",
    "public-demo"
  ],
  "timezone": "Asia/Shanghai",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Backend scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "cae-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"cae-backend\"}",
          "legendFormat": "{{status}} {{analysis_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Running / waiting jobs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cae-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "cae_jobs_running",
          "refId": "A",
          "legendFormat": "{{node}} {{status}} {{analysis_type}} {{feature}} {{state}}"
        },
        {
          "expr": "cae_jobs_waiting_resource",
          "refId": "B",
          "legendFormat": "{{node}} {{status}} {{analysis_type}} {{feature}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 3,
      "title": "Job status by discipline",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cae-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status,analysis_type) (cae_jobs_total)",
          "refId": "A",
          "legendFormat": "{{node}} {{status}} {{analysis_type}} {{feature}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 4,
      "title": "Submit latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "cae-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le) (rate(cae_job_submit_latency_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{node}} {{status}} {{analysis_type}} {{feature}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
